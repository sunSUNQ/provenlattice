{
  "schema": "SQI_ENVELOPE_SCHEMA_V1",
  "schema_version": 2,
  "contract": "STRUCTURED_QUERY_INTERFACE_CONTRACT_V1",
  "note": "Structural schema for SQI-V1 envelopes (V1.2: per-evidence repository/commit and the session-level source_verification_policy are OPTIONAL - see structured-query-interface-contract-v1.2-amendment.md; when present they must match the envelope header / frozen constant, enforced by tools/sqi_validator.py together with the C1-C4 semantic rules and budget accounting. Budget hard caps: max_evidence<=50, max_symbols<=20, max_edges<=50, max_sections<=10).",
  "$defs": {
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hex24": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "evidence_id": {"type": "string", "pattern": "^E-(CODE|CALL|REF|DEP|SHARD|DOC|XLINK)-[0-9a-f]{24}$"},
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "kind", "source_id", "relation", "target_id", "generation", "provenance", "confidence", "summary"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidence_id"},
        "kind": {"enum": ["CODE_DEFINITION", "CALL_RELATION", "REFERENCE", "DEPENDENCY", "SHARD_RELATION", "DOCUMENT_SECTION", "CROSS_LAYER_LINK"]},
        "source_id": {"type": "string"},
        "relation": {"type": "string"},
        "target_id": {"type": "string"},
        "repository": {"type": "string", "pattern": "^repo:[0-9a-f]{64}$"},
        "commit": {"type": "string"},
        "generation": {"type": "integer", "minimum": 0},
        "provenance": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_path": {"type": ["string", "null"]},
        "source_range": {
          "type": ["object", "null"],
          "properties": {"start_line": {"type": ["integer", "null"]}, "end_line": {"type": ["integer", "null"]}}
        },
        "summary": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "budget_caps": {
      "type": "object",
      "required": ["max_evidence", "max_symbols", "max_edges", "max_sections"],
      "properties": {
        "max_evidence": {"type": "integer", "minimum": 0, "maximum": 50},
        "max_symbols": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_edges": {"type": "integer", "minimum": 0, "maximum": 50},
        "max_sections": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    },
    "truncation": {
      "type": "object",
      "required": ["truncated", "omitted_counts"],
      "properties": {
        "truncated": {"type": "boolean"},
        "omitted_counts": {
          "type": "object",
          "required": ["symbols", "edges", "raw_refs", "sections"],
          "properties": {
            "symbols": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0},
            "raw_refs": {"type": "integer", "minimum": 0},
            "sections": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "qualified_name": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "shard_path": {"type": ["string", "null"]},
        "start_line": {"type": ["integer", "null"]},
        "end_line": {"type": ["integer", "null"]}
      }
    }
  },
  "type": "object",
  "required": [
    "sqi_version", "query_id", "query_type", "anchor", "params",
    "repository", "commit", "graph_generation",
    "data", "evidence", "returned_evidence_ids", "returned_evidence_count",
    "bundle_size", "budget", "truncation",
    "query_time_ms"
  ],
  "properties": {
    "sqi_version": {"const": "SQI-V1"},
    "query_id": {"type": "string", "pattern": "^Q-[0-9a-f]{20}$"},
    "query_type": {
      "enum": ["symbol.lookup", "symbol.callers", "symbol.callees",
               "symbol.references", "impact.frontier", "code.related",
               "bundle.explain"]
    },
    "anchor": {"type": "string"},
    "params": {"type": "object"},
    "repository": {"type": "string", "pattern": "^repo:[0-9a-f]{64}$"},
    "commit": {"$ref": "#/$defs/hex40"},
    "graph_generation": {"type": "integer", "minimum": 0},
    "data": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/row"}},
        {"type": "object"}
      ]
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "returned_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
    "returned_evidence_count": {"type": "integer", "minimum": 0},
    "bundle_size": {"type": "integer", "minimum": 0},
    "budget": {
      "type": "object",
      "required": ["declared", "applied", "used"],
      "properties": {
        "declared": {"$ref": "#/$defs/budget_caps"},
        "applied": {"$ref": "#/$defs/budget_caps"},
        "used": {
          "type": "object",
          "required": ["symbols", "edges", "raw_refs", "sections", "evidence"],
          "properties": {
            "symbols": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0},
            "raw_refs": {"type": "integer", "minimum": 0},
            "sections": {"type": "integer", "minimum": 0},
            "evidence": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "truncation": {"$ref": "#/$defs/truncation"},
    "result_meta": {"type": "object"},
    "source_verification_policy": {
      "type": "object",
      "required": ["requires_source_verification", "direct_trust"],
      "properties": {
        "requires_source_verification": {
          "type": "array",
          "minItems": 5,
          "items": {"enum": ["definition_semantics", "call_site_semantics", "reference_purpose", "downstream_impact", "document_equivalence"]}
        },
        "direct_trust": {
          "type": "array",
          "items": {"enum": ["symbol_identity", "edge_existence", "reference_existence_and_status", "frontier_membership"]}
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "query_time_ms": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
