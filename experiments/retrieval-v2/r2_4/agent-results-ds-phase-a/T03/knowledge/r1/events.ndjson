urmurhash_bl"}, "name": "c_murmurhash_bl", "qualified_name": "docs/en/client.md#10b2646294acf078", "repo_id": "repo:074b46c6e95703171fcd66ba04121d7fcacc04ef0fa2e0085f37e49cc4137eac", "shard_id": null, "signature": null, "source_hash": "0829f12ca808ae3f8d71fd69ce3e2b22f247d9e3643b7299a0e1216910c6d027", "start_line": 287}], "returned_evidence_count": 2, "returned_evidence_ids": ["E-XLINK-3284c4dde04ede3b45992a17", "E-XLINK-e0e9be2cf50f895bf973243a"], "summary": "Related document sections for brpc.policy.AddServersInBatch.replicas: 2", "supporting_evidence": [], "suppressed_evidence_count": 2, "suppressed_evidence_ids": ["E-DOC-1ff03fb4980a8d208a8e97e7", "E-DOC-51c12e32861bb02b28d8d99a"], "uncertainties": []}, "run_id": "T03-knowledge-r1-4fc47fea", "task_id": "T03", "arm": "knowledge", "duration": null, "evidence_ids": ["E-XLINK-3284c4dde04ede3b45992a17", "E-XLINK-e0e9be2cf50f895bf973243a"], "viewed_evidence_ids": ["E-XLINK-3284c4dde04ede3b45992a17", "E-XLINK-e0e9be2cf50f895bf973243a"], "used_evidence_ids": ["E-XLINK-3284c4dde04ede3b45992a17", "E-XLINK-e0e9be2cf50f895bf973243a"], "query_id": "Q-5ecf57b68afa614b8349", "query_type": "find_related_documents", "anchor": "brpc.policy.AddServersInBatch.replicas", "bundle_size": 6169, "query_latency": 35.991700016893446, "result_size": 8068, "graph_generation": null, "returned_nodes": null, "returned_edges": null, "returned_evidence": 2, "resolved_count": null, "ambiguous_count": null, "unresolved_count": null, "files": [], "tokens": {}}
