{
  "manifest": "MUTATION_MANIFEST_V1",
  "version": 2,
  "benchmark": "B2-brpc",
  "contract": "SYSTEMS_BENCHMARK_CONTRACT_V1",
  "note": "ops are byte-deterministic: every op pins the frozen source file by sha256 before mutating a throwaway repository copy. expect_sha256 values were computed from benchmark-repos/brpc at frozen commit ae09e960c7291605dda52356cc0c2d45567fb53e. scope/interface_sensitive document mutation representativeness per review R6; DEFERRED families (rename/move, file addition, header high-fanout, branch/overlay merge) are not included.",
  "representativeness": {
    "covered": [
      "local function-body edit (M1)",
      "file-local symbol addition (M2)",
      "file-level deletion / tombstone handling (M3)",
      "cross-file public signature change plus call-site update (M4)"
    ],
    "deferred": [
      "rename/move",
      "file addition",
      "header high-fanout change",
      "branch/overlay merge"
    ]
  },
  "families": [
    {
      "mutation_id": "M1",
      "family": "function_body_edit",
      "scope": "local",
      "interface_sensitive": false,
      "note": "butil/time.cpp: local constant-suffix edit inside butil::monotonic_time_ns(); API unchanged.",
      "ops": [
        {
          "type": "replace_first",
          "file": "src/butil/time.cpp",
          "expect_sha256": "8538d9ad83495c0d96b4e1e4786bc4a9b34197d513d35d91c94bfb54fec2164c",
          "find": "    return now.tv_sec * 1000000000L + now.tv_nsec;",
          "replace": "    return now.tv_sec * 1000000000LL + now.tv_nsec;"
        }
      ],
      "freshness_probe": {
        "expect_file_state_hash_changed": ["src/butil/time.cpp"],
        "expect_file_state_absent": [],
        "expect_symbol_present": [],
        "expect_symbol_absent": [],
        "expect_signature_contains": []
      }
    },
    {
      "mutation_id": "M2",
      "family": "add_symbol",
      "scope": "local",
      "interface_sensitive": false,
      "note": "protocol.cpp: append a new free function in namespace brpc (new symbol, new nodes/references).",
      "ops": [
        {
          "type": "append_text",
          "file": "src/brpc/protocol.cpp",
          "expect_sha256": "240d72636c214dbc48b22f38fc3be62a999a6e1275ff69bafb83c652fa4ad52a",
          "text": "\nnamespace brpc {\n\nint sysv1_mutation_marker()\n{\n  return 42;\n}\n\n} // namespace brpc\n"
        }
      ],
      "freshness_probe": {
        "expect_file_state_hash_changed": ["src/brpc/protocol.cpp"],
        "expect_file_state_absent": [],
        "expect_symbol_present": ["sysv1_mutation_marker"],
        "expect_symbol_absent": [],
        "expect_signature_contains": []
      }
    },
    {
      "mutation_id": "M3",
      "family": "delete_file",
      "scope": "file_level",
      "interface_sensitive": false,
      "note": "delete src/brpc/policy/esp_protocol.cpp: tombstone handling; references pointing into it must drop or become unresolved. Declarations survive via esp_protocol.h, so the probe asserts file_state absence only.",
      "ops": [
        {
          "type": "delete_file",
          "file": "src/brpc/policy/esp_protocol.cpp",
          "expect_sha256": "6071024f7c142e354256a5c493e77c5e78963f91a40ed70d239c4fcd6dce2dcd"
        }
      ],
      "freshness_probe": {
        "expect_file_state_hash_changed": [],
        "expect_file_state_absent": ["src/brpc/policy/esp_protocol.cpp"],
        "expect_symbol_present": [],
        "expect_symbol_absent": [],
        "expect_signature_contains": []
      }
    },
    {
      "mutation_id": "M4",
      "family": "cross_file_signature_change",
      "scope": "cross_file",
      "interface_sensitive": true,
      "note": "public method Socket::SetLogOff gains a defaulted parameter in socket.h (interface), inline definition updated in socket_inl.h, and one call site in controller.cpp passes the new argument. Tests invalidation propagation beyond file-local edits; node identity changes because symbol_id includes the signature.",
      "ops": [
        {
          "type": "replace_first",
          "file": "src/brpc/socket.h",
          "expect_sha256": "97da23a0f115eda08212a03c812dc47c5d168c9ceadd04590d2e25b06757624e",
          "find": "    void SetLogOff();",
          "replace": "    void SetLogOff(bool sysv1_logoff_flag = false);"
        },
        {
          "type": "replace_first",
          "file": "src/brpc/socket_inl.h",
          "expect_sha256": "c47fb0a10e3ca0afe12bf7aa4d7d38ff9289ef6093c3a5ad47e7e0a2ec8face9",
          "find": "inline void Socket::SetLogOff() {",
          "replace": "inline void Socket::SetLogOff(bool sysv1_logoff_flag) {"
        },
        {
          "type": "replace_first",
          "file": "src/brpc/controller.cpp",
          "expect_sha256": "53d03f377fa247758997caa36ff652cc6b55ee4ce21cf56257ceb2889c561336",
          "find": "sock->SetLogOff();",
          "replace": "sock->SetLogOff(true);"
        }
      ],
      "freshness_probe": {
        "expect_file_state_hash_changed": [
          "src/brpc/socket.h",
          "src/brpc/socket_inl.h",
          "src/brpc/controller.cpp"
        ],
        "expect_file_state_absent": [],
        "expect_symbol_present": ["SetLogOff"],
        "expect_symbol_absent": [],
        "expect_signature_contains": [
          {"symbol": "SetLogOff", "token": "sysv1_logoff_flag"}
        ]
      }
    }
  ]
}
